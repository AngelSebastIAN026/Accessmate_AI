
{
  "manifest_version": 3,
  "name": "AccessMate AI",
  "version": "1.0",
  "description": "An AI assistant that helps users understand and navigate websites.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
